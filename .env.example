# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# is injected into the bot container at runtime via `env_file:` in
# docker-compose.yml — never commit real keys, and never bake them into the
# Dockerfile.

# --- Discord (required) ---
DISCORD_TOKEN=your-discord-bot-token

# --- Channel IDs for scheduled pushes (optional; use 0 to disable) ---
MARKET_CHANNEL_ID=0
ALERT_CHANNEL_ID=0
NEWS_CHANNEL_ID=0

# --- All LLM features use OpenRouter (no direct DeepSeek calls) ---
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=2048
# Keep short summaries/classification out of the default high reasoning mode.
LLM_REASONING_ENABLED=false

# --- External data APIs (not routed through OpenRouter) ---
JIN10_API_KEY=your-jin10-mcp-token
NEWS_API_KEY=your-newsapi-key
FRED_API_KEY=your-fred-api-key
FMP_API_KEY=your-fmp-api-key

# --- Monitoring (optional) ---
# Port the bot exposes Prometheus metrics on (scraped as bot:9091 by Prometheus).
METRICS_PORT=9091
# OpenRouter usage.cost populates llm_cost_usd_total when supplied.
# These optional estimates (USD / 1M tokens) only apply when cost is missing.
LLM_PRICE_PROMPT_PER_1M=0
LLM_PRICE_COMPLETION_PER_1M=0
